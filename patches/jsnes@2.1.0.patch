@@ -0,0 +1,47 @@
+import Mapper0 from "./mapper0.js";
+
+// Waixing FS304 / Mapper 164
+// Used by many Chinese pirate / translation cartridges.
+// 32 KB PRG bank selected via nibble writes at $5000/$5100; CHR is RAM.
+// See Mesen Waixing164 / https://www.nesdev.org/wiki/INES_Mapper_164
+class Mapper164 extends Mapper0 {
+  static mapperName = "Waixing (Mapper 164)";
+
+  constructor(nes) {
+    super(nes);
+    this.prgBank = 0x0f;
+  }
+
+  write(address, value) {
+    if (address < 0x5000 || address > 0x5fff) {
+      super.write(address, value);
+      return;
+    }
+
+    switch (address & 0x7300) {
+      case 0x5000:
+        this.prgBank = (this.prgBank & 0xf0) | (value & 0x0f);
+        this.load32kRomBank(this.prgBank, 0x8000);
+        break;
+      case 0x5100:
+        this.prgBank = (this.prgBank & 0x0f) | ((value & 0x0f) << 4);
+        this.load32kRomBank(this.prgBank, 0x8000);
+        break;
+      default:
+        break;
+    }
+  }
+
+  loadROM() {
+    if (!this.nes.rom.valid) {
+      throw new Error("Mapper 164: Invalid ROM! Unable to load.");
+    }
+
+    this.prgBank = 0x0f;
+    this.load32kRomBank(this.prgBank, 0x8000);
+    this.loadCHRROM();
+    this.nes.cpu.requestIrq(this.nes.cpu.IRQ_RESET);
+  }
+}
+
+export default Mapper164;
